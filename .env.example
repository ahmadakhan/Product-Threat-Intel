APP_DB_PASSWORD=
PORT=8080
APP_HOST=
POSTGRES_PORT=5433
EGRESS_ALLOWED_HOSTS=raw.githubusercontent.com,services.nvd.nist.gov,www.cisa.gov,cisa.gov,api.first.org,api.vulncheck.com,otx.alienvault.com,www.bleepingcomputer.com,isc.sans.edu,api.msrc.microsoft.com,api.mailgun.net,api.eu.mailgun.net,send.api.mailtrap.io,sandbox.api.mailtrap.io,api.sendgrid.com,smtp.sendgrid.net,api.postmarkapp.com,smtp.maileroo.com,smtp.lettr.com,in-v3.mailjet.com,api.mailjet.com,smtp.gmail.com,www.fortiguard.com,filestore.fortinet.com,www.kb.cert.org,kb.cert.org,thehackernews.com,feeds.feedburner.com,www.securityweek.com,www.rapid7.com,googleprojectzero.blogspot.com,projectzero.google,krebsonsecurity.com,tools.cisco.com,sec.cloudapps.cisco.com,security.paloaltonetworks.com,labs.watchtowr.com,www.talosintelligence.com,www.thezdi.com,www.exploit-db.com,www.debian.org,www.cisecurity.com,cisecurity.com,cisecurity.org,www.cisecurity.org,seclists.org,blog.sucuri.net,www.welivesecurity.com,wordpress.org,www.darkreading.com,blog.google,www.greynoise.io,www.malwarebytes.com,cloudblog.withgoogle.com,cloud.google.com,workspace.google.com,blog.twitter.com,blog.x.com,github.com,www.pentestpartners.com,www.forbes.com,www.theregister.com,news.google.com,www.sophos.com,api.osv.dev,therecord.media,www.googleapis.com,psirtapi.global.sonicwall.com,psirt.global.sonicwall.com,security.access.redhat.com,ubuntu.com
ENCRYPTION_KEY=
# HMAC key for ML model artifacts. Required in production (minimum 32
# characters); install.sh generates one. Without it artifacts are unsigned.
ML_SIGNING_KEY=
# Training history window; defaults to the ML Operations feedback window.
ML_LOOKBACK_DAYS=30
FEED_MAX_DURATION_SECONDS=
FEED_CONCURRENCY=10
# Transient feed retry policy. Attempts include the first request; a provider's
# Retry-After and pacing requirements are always honored.
FEED_RETRY_MAX_ATTEMPTS=3
FEED_RETRY_VULNCHECK_MAX_ATTEMPTS=5
FEED_RETRY_BASE_DELAY_MS=2000
FEED_RETRY_MAX_DELAY_MS=30000
FEED_RETRY_JITTER_FACTOR=0.2
POSTGRES_PASSWORD=
SMTP_FROM=
SMTP_HOST=
SMTP_PASSWORD=
SMTP_PORT=
SMTP_USER=
MJ_APIKEY_PUBLIC=
MJ_APIKEY_PRIVATE=

# Dedicated read-only metrics bearer token for an external scraper; empty
# disables /metrics. Prometheus is not part of the Compose deployment.
METRICS_TOKEN=
# Logging verbosity for server stdout. Use 'verbose' for per-operation detail
# (pipeline, ingestion, delivery, retention); 'standard' is the default.
LOG_LEVEL=standard
# PostgreSQL pool tuning. All values are validated at startup; empty means the
# default shown. POOL_STATEMENT_TIMEOUT_MS is enforced server-side per session.
# POOL_STATEMENT_TIMEOUT_MS=15000
# POOL_KEEPALIVE_DELAY_MS=5000
# POOL_MAX_CONNECTIONS=25
# POOL_CONNECTION_TIMEOUT_MS=5000
# POOL_IDLE_TIMEOUT_MS=30000
# POOL_MAX_LIFETIME_MS=600000
# Silence window for the background-job watchdog. A heartbeat resets it, so
# this bounds one silent phase rather than a whole ingestion run. Raise it if a
# legitimate source request or statement can stay silent longer than 5 minutes.
STUCK_PROMISE_MS=300000
# Seed data is manual only: `npm run seed` (see scripts/seed.ts).
CORRELATION_DLQ_DIRECTORY=data/correlation-dlq
CORRELATION_DLQ_STORAGE_MODE=database
ML_STORAGE_MODE=database
